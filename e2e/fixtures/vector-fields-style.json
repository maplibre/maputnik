{
    "id": "test-style",
    "version": 8,
    "name": "Test Style",
    "metadata": {
        "maputnik:renderer": "mlgljs"
    },
    "sources": {
        "example_vector": {
            "type": "vector",
            "url": "https://tiles.example.org/tiles.json"
        }
    },
    "glyphs": "https://example.local/fonts/{fontstack}/{range}.pbf",
    "sprites": "https://example.local/fonts/{fontstack}/{range}.pbf",
    "layers": [
        {
            "id": "fill-layer",
            "type": "fill",
            "source": "example_vector",
            "source-layer": "mylayer"
        }
    ]
}
